---
import BaseLayout from "../layouts/BaseLayout.astro";
import data from "../data/experience.json";

const { profile, roles, tech } = data;

/* The axis runs from the first year worked to the current year. Both views
   share it, so a role bar and a technology bar at the same x are the same
   moment in time. */
const AXIS_START = profile.careerStart;
const AXIS_END = new Date().getFullYear();
const SPAN = AXIS_END - AXIS_START + 1;

const years = Array.from({ length: SPAN }, (_, i) => AXIS_START + i);

/** Months since the axis origin, so a July start sits mid-year rather than
 *  snapping to January. */
const months = (iso: string | null) => {
  if (!iso) return (AXIS_END + 1 - AXIS_START) * 12;
  const [y, m] = iso.split("-").map(Number);
  return (y - AXIS_START) * 12 + ((m ?? 1) - 1);
};

const TOTAL = SPAN * 12;
const pct = (n: number) => `${(n / TOTAL) * 100}%`;

const bar = (start: string, end: string | null) => {
  const a = months(start);
  const b = months(end);
  return `left:${pct(a)};width:${pct(b - a)}`;
};

const yearBar = (from: number, to: number | null) =>
  bar(`${from}-01`, to ? `${to}-12` : null);

const fmt = (iso: string | null) =>
  iso
    ? new Date(`${iso}-01T00:00:00Z`).toLocaleDateString("en", {
        month: "short",
        year: "numeric",
        timeZone: "UTC",
      })
    : "Present";

const categories = [...new Set(tech.map((t) => t.category))];
const learning = profile.learning;
const totalYears = AXIS_END - AXIS_START;
---

<BaseLayout
  title="Experience"
  description={`${totalYears}+ years building for the web — roles, and the stack as it accumulated.`}
  ogImage="/og/experience.png"
>
  <article class="wrap page">
    <header class="intro">
      <h1>Experience</h1>
      <p class="lede">
        {totalYears} years, three companies, one continuous shift from back-end
        to front-end. The same data twice: <strong>Timeline</strong> for what
        happened when, <strong>Skills</strong> for how long each thing has been
        in hand.
      </p>
    </header>

    <div class="views">
      <div class="tabs" role="tablist" aria-label="Experience views">
        <button id="tab-timeline" role="tab" aria-selected="true" aria-controls="panel-timeline">Timeline</button>
        <button id="tab-skills" role="tab" aria-selected="false" aria-controls="panel-skills">Skills</button>
      </div>

      <!-- Timeline ------------------------------------------------------- -->
      <section id="panel-timeline" role="tabpanel" aria-labelledby="tab-timeline">
        <div class="scroller">
          <div class="chart" style={`--span:${SPAN}`}>
            <div class="axis" aria-hidden="true">
              {years.map((y) => <span class="tick">{y === AXIS_START || y % 2 === 0 ? y : ""}</span>)}
            </div>
            <ol class="rail">
              {roles.map((r) => (
                <li>
                  <span class="track" aria-hidden="true">
                    <span class="fill" style={bar(r.start, r.end)}>
                      <span class="label">{r.org}</span>
                    </span>
                  </span>
                </li>
              ))}
            </ol>
          </div>
        </div>

        <ol class="stations">
          {roles.map((r) => (
            <li>
              <p class="period">
                <time>{fmt(r.start)}</time> — <time>{fmt(r.end)}</time>
                {r.end === null && <span class="now">current</span>}
              </p>
              <h2>
                {r.org}
                {r.orgNote && <span class="note"> ({r.orgNote})</span>}
              </h2>
              <p class="role">{r.title}{r.context && <span class="ctx"> · {r.context}</span>}</p>
              <ul>
                {r.highlights.map((h) => <li>{h}</li>)}
              </ul>
            </li>
          ))}
        </ol>
      </section>

      <!-- Skills --------------------------------------------------------- -->
      <section id="panel-skills" role="tabpanel" aria-labelledby="tab-skills" hidden>
        <div class="scroller">
          <div class="chart" style={`--span:${SPAN}`}>
            <div class="axis" aria-hidden="true">
              {years.map((y) => <span class="tick">{y === AXIS_START || y % 2 === 0 ? y : ""}</span>)}
            </div>

            {categories.map((cat) => (
              <div class="group">
                <h3>{cat}</h3>
                <ol class="rail skills">
                  {tech.filter((t) => t.category === cat).map((t) => (
                    <li>
                      <span class="name">{t.name}</span>
                      <span class="track">
                        <span
                          class:list={["fill", { open: t.to === null }]}
                          style={yearBar(t.from, t.to)}
                        />
                      </span>
                      <span class="span-label">
                        {t.from}–{t.to ?? "now"}
                      </span>
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </div>
        </div>
        <p class="caveat">
          Bars that run to the right edge are still in use. Ranges are at year
          granularity — precise enough to answer “how long”, honest about the
          fact that nobody remembers the month.
        </p>
      </section>
    </div>

    <section class="learning">
      <h2>The newest thing</h2>
      <ul>
        {learning.items.map((l) => (
          <li>
            <span class="what">
              {l.name}
              {learning.since && <span class="since"> since {learning.since}</span>}
            </span>
            <span class="detail">{l.detail}</span>
          </li>
        ))}
      </ul>
      <p class="why">
        Called out rather than buried in the grid: one year against sixteen is
        a difference worth being straight about, and a skills list that hides
        it stops meaning anything.
      </p>
    </section>

    <section class="education">
      <h2>Education &amp; certification</h2>
      <ul>
        {profile.education.map((e) => (
          <li><span class="yr">{e.year}</span> {e.title}</li>
        ))}
      </ul>
      <p class="resume-link">
        Prefer it as plain text? <a href="/resume">Read the resume</a>.
      </p>
    </section>
  </article>
</BaseLayout>

<script>
  const tabs = [
    ["tab-timeline", "panel-timeline"],
    ["tab-skills", "panel-skills"],
  ] as const;

  for (const [tabId, panelId] of tabs) {
    document.getElementById(tabId)?.addEventListener("click", () => {
      for (const [t, p] of tabs) {
        const on = t === tabId;
        document.getElementById(t)?.setAttribute("aria-selected", String(on));
        const panel = document.getElementById(p);
        if (panel) panel.hidden = !on;
      }
      try {
        localStorage.setItem("experience-view", panelId);
      } catch {}
    });
  }

  try {
    const saved = localStorage.getItem("experience-view");
    if (saved === "panel-skills") document.getElementById("tab-skills")?.click();
  } catch {}
</script>

<style>
  .page { padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem); }

  .intro { max-width: var(--measure); }
  h1 {
    font-family: var(--f-display);
    font-size: var(--t-2xl);
    color: var(--ink);
    letter-spacing: -0.02em;
  }
  .lede {
    margin-top: 0.75rem;
    font-size: var(--t-lg);
    color: var(--muted);
    text-wrap: pretty;
  }
  .lede strong { color: var(--body); font-weight: 500; }

  /* --- tabs --------------------------------------------------------------- */
  .tabs {
    display: flex;
    gap: 0.25rem;
    margin-block: 2rem 1.25rem;
    padding: 0.25rem;
    background: var(--sunk);
    border-radius: var(--radius);
    width: max-content;
  }
  .tabs button {
    font: inherit;
    font-size: var(--t-sm);
    padding: 0.4rem 0.9rem;
    border: 0;
    border-radius: calc(var(--radius) - 4px);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .tabs button[aria-selected="true"] {
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow);
  }

  /* --- shared chart ------------------------------------------------------- */
  .scroller { overflow-x: auto; padding-bottom: 0.5rem; }
  .chart { min-width: 40rem; }

  .axis {
    display: grid;
    grid-template-columns: repeat(var(--span), 1fr);
    border-bottom: 1px solid var(--rule);
    margin-bottom: 0.75rem;
  }
  .tick {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--muted);
    padding-bottom: 0.35rem;
    border-left: 1px solid var(--rule-soft);
    padding-left: 0.3rem;
  }

  .rail { list-style: none; display: grid; gap: 0.5rem; }
  .rail > li { display: grid; align-items: center; }

  .track {
    position: relative;
    display: block;
    height: 2.1rem;
    background: var(--sunk);
    border-radius: 6px;
  }
  .fill {
    position: absolute;
    inset-block: 0;
    background: var(--accent);
    border-radius: 6px;
    display: flex;
    align-items: center;
    padding-inline: 0.6rem;
    min-width: 2px;
  }
  .fill .label {
    font-size: var(--t-xs);
    font-weight: 500;
    color: var(--surface);
    white-space: nowrap;
  }

  /* --- skills view -------------------------------------------------------- */
  .group { margin-bottom: 1.5rem; }
  .group h3 {
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
  .rail.skills > li {
    grid-template-columns: 11rem 1fr 5rem;
    gap: 0.75rem;
  }
  .rail.skills .track { height: 1.5rem; }
  .rail.skills .fill { background: var(--clay); opacity: 0.85; }
  .rail.skills .fill.open { background: var(--accent); opacity: 1; }
  .name { font-size: var(--t-sm); color: var(--body); }
  .span-label {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--muted);
    text-align: right;
  }
  .caveat {
    max-width: var(--measure);
    font-size: var(--t-sm);
    color: var(--muted);
    margin-top: 1rem;
  }

  /* --- stations ----------------------------------------------------------- */
  .stations {
    list-style: none;
    margin-top: 2.5rem;
    display: grid;
    gap: 2.5rem;
  }
  .stations > li {
    border-left: 2px solid var(--rule);
    padding-left: 1.25rem;
    max-width: 44rem;
  }
  .period {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .now {
    background: var(--accent-q);
    color: var(--accent);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .stations h2 {
    font-family: var(--f-display);
    font-size: var(--t-xl);
    color: var(--ink);
    margin-top: 0.3rem;
  }
  .stations h2 .note { font-family: var(--f-body); font-size: var(--t-sm); color: var(--muted); font-weight: 400; }
  .role { color: var(--body); font-size: var(--t-base); margin-top: 0.15rem; }
  .role .ctx { color: var(--muted); }
  .stations ul { margin-top: 0.9rem; padding-left: 1.1rem; display: grid; gap: 0.45rem; }
  .stations ul li { color: var(--body); font-size: var(--t-sm); text-wrap: pretty; }

  /* --- currently learning ------------------------------------------------ */
  .learning { margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid var(--rule); max-width: 44rem; }
  .learning h2 { font-family: var(--f-display); font-size: var(--t-lg); color: var(--ink); }
  .learning ul { list-style: none; margin-top: 1rem; display: grid; gap: 0.9rem; }
  .learning li {
    display: grid;
    gap: 0.2rem;
    border-left: 2px dashed var(--rule);
    padding-left: 1rem;
  }
  .what { font-size: var(--t-base); color: var(--ink); font-weight: 500; }
  .since { font-family: var(--f-mono); font-size: var(--t-xs); color: var(--muted); font-weight: 400; }
  .detail { font-size: var(--t-sm); color: var(--body); text-wrap: pretty; }
  .why { margin-top: 1.1rem; font-size: var(--t-sm); color: var(--muted); text-wrap: pretty; }

  /* --- education ---------------------------------------------------------- */
  .education { margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid var(--rule); max-width: var(--measure); }
  .education h2 { font-family: var(--f-display); font-size: var(--t-lg); color: var(--ink); }
  .education ul { list-style: none; margin-top: 0.9rem; display: grid; gap: 0.4rem; }
  .education li { color: var(--body); font-size: var(--t-sm); }
  .yr { font-family: var(--f-mono); font-size: var(--t-xs); color: var(--muted); margin-right: 0.6rem; }
  .resume-link { margin-top: 1.25rem; font-size: var(--t-sm); color: var(--muted); }

  @media (max-width: 40rem) {
    .rail.skills > li { grid-template-columns: 7.5rem 1fr 4rem; gap: 0.5rem; }
  }
</style>
