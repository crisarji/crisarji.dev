---
import BaseLayout from "../layouts/BaseLayout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import data from "../data/experience.json";

/* Holding page while the site is rebuilt.

   It is deliberately not an "under construction" notice. The premise of the
   redesign is that the career data IS the imagery — no client screenshots
   exist and none are coming — so the holding page renders the smallest honest
   version of that: sixteen years on one axis. If this does not feel like a
   product, the token set is wrong and it is cheap to find out here. */

const { profile, roles, tech } = data;

const AXIS_START = profile.careerStart;
const AXIS_END = new Date().getFullYear();

/* Months since the axis origin, so a role that starts mid-year lands in the
   right place rather than snapping to January. An open-ended role runs to the
   end of the axis. */
const months = (iso: string | null) => {
  if (!iso) return (AXIS_END + 1 - AXIS_START) * 12;
  const [y, m] = iso.split("-").map(Number);
  return (y - AXIS_START) * 12 + ((m ?? 1) - 1);
};

const SPAN = (AXIS_END + 1 - AXIS_START) * 12;
const pct = (m: number) => `${((m / SPAN) * 100).toFixed(2)}%`;

const year = (iso: string | null) => (iso ? iso.slice(0, 4) : "now");

/* Colour encodes time. Each bar is a slice of a single ramp that runs across
   the whole axis — indigo at 2010, brand teal at the present — so the fills
   mean something instead of each bar repeating the same gradient. Expressed as
   "how far toward accent-2", which is what color-mix() wants. */
const ramp = (m: number) => `${(100 - (m / SPAN) * 100).toFixed(1)}%`;

// Oldest first, so the figure reads left to right like the axis.
const bars = [...roles].reverse().map((r, i) => ({
  org: r.org,
  from: year(r.start),
  to: year(r.end),
  current: r.end === null,
  left: pct(months(r.start)),
  width: pct(months(r.end) - months(r.start)),
  cFrom: ramp(months(r.start)),
  cTo: ramp(months(r.end)),
  delay: `${260 + i * 110}ms`,
}));

const years = AXIS_END - AXIS_START;

const stats = [
  { figure: `${years}`, label: "years" },
  { figure: `${roles.length}`, label: "companies" },
  { figure: `${tech.length}`, label: "technologies" },
];

const links = [
  { href: "/resume", label: "Resume" },
  { href: "mailto:crisarji@gmail.com", label: "Email" },
  { href: "https://github.com/crisarji", label: "GitHub", ext: true },
  {
    href: "https://www.linkedin.com/in/cristian-arce-a0757158/",
    label: "LinkedIn",
    ext: true,
  },
];
---

<BaseLayout
  title="crisarji"
  description={`Cristian Arce — software engineer, ${years} years in. Front-end architecture, design systems and micro frontends. Site being rebuilt; the resume is up.`}
  ogImage="/og/site.png"
  chrome={false}
>
  <div class="glow" aria-hidden="true"></div>

  <div class="shell">
    <section class="card">
      <div class="corner">
        <ThemeToggle />
      </div>

      <p class="eyebrow enter-fade">crisarji.dev</p>

      <h1 class="enter" style="--delay:60ms">{profile.name}</h1>

      <p class="lede enter" style="--delay:120ms">
        Software engineer, {years} years in. Front-end architecture, design
        systems and micro frontends for US-based clients — from Costa Rica.
      </p>

      <figure class="arc enter" style="--delay:200ms">
        <figcaption class="eyebrow">The shape of it</figcaption>

        <ol class="rows">
          {
            bars.map((b) => (
              <li class:list={["row", b.current && "is-current"]}>
                <span class="org">{b.org}</span>
                <span class="track">
                  <span
                    class="bar draw"
                    style={`left:${b.left};width:${b.width};--c-from:${b.cFrom};--c-to:${b.cTo};--delay:${b.delay}`}
                  />
                </span>
                <span class="span">
                  {b.from}<span class="dash">–</span>{b.to}
                </span>
              </li>
            ))
          }
        </ol>

        <div class="axis" aria-hidden="true">
          <span>{AXIS_START}</span>
          <span>{AXIS_END}</span>
        </div>
      </figure>

      <ul class="stats enter" style="--delay:300ms">
        {
          stats.map((s) => (
            <li>
              <span class="figure">{s.figure}</span>
              <span class="label">{s.label}</span>
            </li>
          ))
        }
      </ul>

      <p class="note enter" style="--delay:380ms">
        This site is being rebuilt — the full record of trajectory, skill set
        and projects is on its way. The resume is already up, and email is the
        reliable way to reach me.
      </p>

      <ul class="links enter" style="--delay:440ms">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                target={l.ext ? "_blank" : undefined}
                rel={l.ext ? "noopener" : undefined}
              >
                {l.label}
                {l.ext && <span aria-hidden="true">↗</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  /* --- ambient ------------------------------------------------------------ */

  .glow {
    --wash-a: 26%;
    --wash-b: 22%;
    --wash-c: 16%;
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(
        42rem 32rem at 12% -8%,
        color-mix(in srgb, var(--accent) var(--wash-a), transparent),
        transparent 70%
      ),
      radial-gradient(
        38rem 30rem at 92% 8%,
        color-mix(in srgb, var(--accent-2) var(--wash-b), transparent),
        transparent 70%
      ),
      radial-gradient(
        50rem 34rem at 50% 108%,
        color-mix(in srgb, var(--accent) var(--wash-c), transparent),
        transparent 72%
      );
  }

  /* Dark needs a lighter hand: the same wash over near-black turns milky. */
  :global(html[data-theme="dark"]) .glow {
    --wash-a: 16%;
    --wash-b: 14%;
    --wash-c: 10%;
  }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme="light"])) .glow {
      --wash-a: 16%;
      --wash-b: 14%;
      --wash-c: 10%;
    }
  }

  /* --- shell -------------------------------------------------------------- */

  .shell {
    position: relative;
    flex: 1;
    display: grid;
    place-items: center;
    padding: clamp(1.25rem, 3vw, 2rem) var(--gap);
  }

  .corner {
    position: absolute;
    top: clamp(1rem, 3vw, 1.5rem);
    right: clamp(1rem, 3vw, 1.5rem);
  }

  .card {
    position: relative;
    width: 100%;
    max-width: 44rem;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    background: var(--veil);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    box-shadow: var(--e-3);
    backdrop-filter: blur(20px) saturate(150%);
  }

  .eyebrow { padding-right: 3rem; }

  h1 {
    margin-top: 0.5rem;
    font-size: var(--t-3xl);
    font-weight: 700;
  }

  .lede {
    margin-top: 0.85rem;
    max-width: 32rem;
    font-size: var(--t-lg);
    color: var(--body);
  }

  /* --- the figure --------------------------------------------------------- */

  .arc {
    margin-top: clamp(1.5rem, 4vw, 2rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule-soft);
  }

  .rows {
    list-style: none;
    padding: 0;
    margin-top: 1.1rem;
    display: grid;
    gap: 0.55rem;
  }

  .row {
    display: grid;
    grid-template-columns: 7.5rem 1fr 5.25rem;
    align-items: center;
    gap: 0.9rem;
  }

  .org {
    font-size: var(--t-sm);
    font-weight: 500;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .track {
    position: relative;
    height: 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }

  .bar {
    position: absolute;
    inset-block: 0;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--accent-2) var(--c-from), var(--accent)) 0%,
      color-mix(in oklab, var(--accent-2) var(--c-to), var(--accent)) 100%
    );
    transform-origin: left center;
  }

  /* The open-ended role is the one that matters most, so it gets the only
     emphasis in the figure. */
  .is-current .bar {
    box-shadow:
      0 0 0 2px color-mix(in srgb, var(--accent) 22%, transparent),
      0 0 18px color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .is-current .org { font-weight: 600; }

  .span {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--muted);
    text-align: right;
    white-space: nowrap;
  }
  .dash { color: var(--faint); padding-inline: 0.1em; }

  .axis {
    margin-top: 0.9rem;
    padding-top: 0.6rem;
    border-top: 1px dashed var(--rule-soft);
    display: flex;
    justify-content: space-between;
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--faint);
  }

  /* --- stats -------------------------------------------------------------- */

  .stats {
    list-style: none;
    padding: 0;
    margin-top: clamp(1.25rem, 3vw, 1.75rem);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .stats li {
    padding: 0.85rem 1rem;
    background: var(--grad-soft);
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius);
    display: grid;
    gap: 0.1rem;
  }

  .figure {
    font-family: var(--f-mono);
    font-size: var(--t-xl);
    font-weight: 500;
    color: var(--ink);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .label {
    font-size: var(--t-xs);
    color: var(--muted);
  }

  /* --- tail --------------------------------------------------------------- */

  .note {
    margin-top: clamp(1.25rem, 3vw, 1.75rem);
    max-width: 34rem;
    font-size: var(--t-sm);
    color: var(--muted);
  }

  .links {
    list-style: none;
    padding: 0;
    margin-top: 1.1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .links a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    padding: 0.45rem 0.9rem;
    font-size: var(--t-sm);
    color: var(--ink);
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 999px;
    box-shadow: var(--e-1);
    transition:
      transform var(--dur-2) var(--ease-out),
      border-color var(--dur-1) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }
  .links a:hover {
    transform: var(--lift);
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 55%, var(--rule));
    box-shadow: var(--e-2);
  }
  .links a span { font-size: 0.8em; color: var(--faint); }
  .links a:hover span { color: var(--accent); }

  /* --- narrow ------------------------------------------------------------- */

  @media (max-width: 34rem) {
    /* The bar keeps its proportional width, so duration still reads; only the
       label and the span move off the row. */
    .row {
      grid-template-columns: 1fr auto;
      gap: 0.3rem 0.75rem;
    }
    .org { grid-row: 1; }
    .span { grid-row: 1; }
    .track { grid-row: 2; grid-column: 1 / -1; }
    .rows { gap: 1rem; }

    .stats { grid-template-columns: 1fr; }
    .stats li {
      grid-template-columns: 3.5rem 1fr;
      align-items: baseline;
      gap: 0.5rem;
    }
  }
</style>
