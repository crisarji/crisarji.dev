---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import "../styles/motion.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Pages that supply their own full-bleed composition (the holding page)
   *  opt out of the site header and footer. */
  chrome?: boolean;
}

const { title, description, ogImage, chrome = true } = Astro.props;

const siteName = "crisarji";
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = ogImage ? new URL(ogImage, Astro.site) : undefined;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    <meta name="twitter:card" content={ogUrl ? "summary_large_image" : "summary"} />

    <!-- Two families: Inter carries everything, the mono carries labels and
         figures. Keep it at two — the budget assumes it. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <!--
      Theme must be resolved before first paint or the page flashes.
      Inline and synchronous on purpose — do not move this to a module script.
      The stylesheet also answers prefers-color-scheme on its own, so a browser
      that never runs this still gets the right theme; the attribute exists so
      the toggle can override the system preference.
    -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          if (stored) document.documentElement.dataset.theme = stored;
        } catch {
          /* Blocked storage: the media query in global.css still applies. */
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {chrome && <Header />}
    <main id="main">
      <slot />
    </main>
    {chrome && <Footer />}
  </body>
</html>
