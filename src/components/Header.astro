---
import ThemeToggle from "./ThemeToggle.astro";

/* Anchors are absolute so the nav also works from /resume. /work and
   /experience return in phases 5 and 4. */
const links = [
  { href: "/#trajectory", label: "Trajectory" },
  { href: "/#skills", label: "Skills" },
  { href: "/#about", label: "About" },
  { href: "/resume", label: "Resume" },
];

const path = Astro.url.pathname;
---

<header>
  <div class="wrap bar">
    <a href="/" class="mark" aria-label="Home">crisarji<span>.dev</span></a>

    <nav aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={path === link.href ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--rule-soft);
    background: color-mix(in srgb, var(--ground) 82%, transparent);
    backdrop-filter: blur(12px) saturate(140%);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 4vw, 2.5rem);
    min-height: 4rem;
  }

  .mark {
    font-family: var(--f-mono);
    font-weight: 500;
    font-size: var(--t-sm);
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.02em;
    margin-right: auto;
    flex: none;
  }
  .mark span { color: var(--faint); }
  .mark:hover span { color: var(--accent); }

  nav ul {
    display: flex;
    gap: clamp(0.75rem, 2.5vw, 1.6rem);
    list-style: none;
    padding: 0;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: var(--t-sm);
    padding-block: 0.35rem;
    border-bottom: 1.5px solid transparent;
    transition: color var(--dur-1) var(--ease-out);
    white-space: nowrap;
  }
  nav a:hover { color: var(--ink); }
  nav a[aria-current="page"] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  /* The wordmark is the home link; the section anchors would wrap badly. */
  @media (max-width: 34rem) {
    nav li:not(:last-child) { display: none; }
  }
</style>
