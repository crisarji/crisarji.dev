---
import ThemeToggle from "./ThemeToggle.astro";

/* The site is mid-rebuild: /work, /experience and /about are off the air, so
   they are not listed. Restore them here as each one lands. */
const links = [{ href: "/resume", label: "Resume" }];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header>
  <div class="wrap bar">
    <a href="/" class="mark" aria-label="Home">crisarji<span>.dev</span></a>

    <nav aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--rule-soft);
    background: color-mix(in srgb, var(--ground) 82%, transparent);
    backdrop-filter: blur(12px) saturate(140%);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 4vw, 2.5rem);
    min-height: 4rem;
  }

  .mark {
    font-family: var(--f-mono);
    font-weight: 500;
    font-size: var(--t-sm);
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.02em;
    margin-right: auto;
  }
  .mark span { color: var(--faint); }
  .mark:hover span { color: var(--accent); }

  nav ul {
    display: flex;
    gap: clamp(1rem, 3vw, 1.75rem);
    list-style: none;
    padding: 0;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: var(--t-sm);
    padding-block: 0.35rem;
    border-bottom: 1.5px solid transparent;
    transition: color var(--dur-1) var(--ease-out);
  }
  nav a:hover { color: var(--ink); }
  nav a[aria-current="page"] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
</style>
