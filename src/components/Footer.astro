---
const year = new Date().getFullYear();

const elsewhere = [
  { href: "https://github.com/crisarji", label: "GitHub" },
  { href: "mailto:crisarji@gmail.com", label: "Email" },
];
---

<footer>
  <div class="wrap bar">
    <p>© {year} Cris Arji</p>
    <ul>
      {
        elsewhere.map((link) => (
          <li>
            <a
              href={link.href}
              rel={link.href.startsWith("http") ? "noopener" : undefined}
              target={link.href.startsWith("http") ? "_blank" : undefined}
            >
              {link.label}
              {link.href.startsWith("http") && <span aria-hidden="true"> ↗</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  footer {
    margin-top: auto;
    border-top: 1px solid var(--rule-soft);
    padding-block: 2rem;
    font-size: var(--t-sm);
    color: var(--muted);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: center;
    justify-content: space-between;
  }

  ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
  }

  a { color: var(--muted); text-decoration: none; }
  a:hover { color: var(--accent); text-decoration: underline; }
</style>
